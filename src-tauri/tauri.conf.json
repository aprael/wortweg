{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wortweg",
  "version": "../package.json",
  "identifier": "io.github.aprael.wortweg",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Education",
    "shortDescription": "Freie Sprachlern-App",
    "longDescription": "Wortweg – freie Sprachlern-App: Lernpfad, Übungen, Wiederholung, echte Aufnahmen. Offline, ohne Konto, ohne Werbung.",
    "homepage": "https://aprael.github.io/wortweg/",
    "copyright": "Code: MIT-Lizenz. Kurse und Aufnahmen: siehe „Über Wortweg“ in der App.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
