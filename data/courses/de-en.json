            { "native": ["Sie ist Lehrerin."], "target": ["She is a teacher."], "note": "Bei Berufen steht im Englischen „a/an“: „She is a teacher.“" },
            { "native": ["Ich lerne Englisch."], "target": ["I learn English.", "I am learning English.", "I study English.", "I'm learning English."], "note": "Sprachen schreibt man groß: „English“." },
            { "native": ["Das Treffen ist um zehn."], "target": ["The meeting is at ten.", "The meeting is at ten o'clock."], "note": "Uhrzeit mit „at“: „at ten“." },
            { "native": ["Ich bin heute beschäftigt."], "target": ["I am busy today.", "I'm busy today."], "note": "„beschäftigt“ = „busy“." },
            { "native": ["Er liest ein Buch."], "target": ["He reads a book.", "He is reading a book."], "note": "Gerade jetzt: „is reading“ (Verlaufsform)." },
            { "native": ["Die Aufgabe ist schwierig."], "target": ["The task is difficult.", "The task is hard.", "The exercise is difficult."], "note": "„difficult“ und „hard“ sind hier beide richtig." },
