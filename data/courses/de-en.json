            { "native": ["Er spielte Fußball."], "target": ["He played football.", "He played soccer."], "note": "Regelmäßige Verben: + -ed." },
            { "native": ["Wo warst du?"], "target": ["Where were you?"], "note": "Bei „you“ immer „were“." },
            { "native": ["Das war vor zwei Tagen."], "target": ["That was two days ago.", "It was two days ago."], "note": "„ago“ steht nach der Zeitangabe." },
