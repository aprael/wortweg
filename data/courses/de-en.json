            { "native": ["kaufte"], "target": ["bought"], "note": "Unregelmäßig: buy → bought." }
          ],
          "sentences": [
            { "native": ["Gestern war ich müde."], "target": ["Yesterday I was tired.", "I was tired yesterday."], "note": "„ich war“ = „I was“. Zeitangaben stehen oft am Satzende." },
            { "native": ["Wir gingen ins Kino."], "target": ["We went to the cinema.", "We went to the movies."], "note": "go → went (unregelmäßig)." },
            { "native": ["Ich sah einen Film."], "target": ["I saw a film.", "I saw a movie.", "I watched a film.", "I watched a movie."], "note": "„see“ → „saw“; für Filme auch „watch“ → „watched“." },
