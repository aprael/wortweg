            { "native": ["glauben"], "target": ["believe"] },
            { "native": ["Meinung"], "target": ["opinion"] },
            { "native": ["zustimmen"], "target": ["agree"] },
            { "native": ["weil"], "target": ["because"] },
            { "native": ["aber"], "target": ["but"] },
            { "native": ["vielleicht"], "target": ["maybe", "perhaps"] },
            { "native": ["wichtig"], "target": ["important"] },
            { "native": ["wahr"], "target": ["true"] },
            { "native": ["falsch"], "target": ["wrong", "false"] },
            { "native": ["besser"], "target": ["better"], "note": "Unregelmäßige Steigerung: good → better → best." },
            { "native": ["sicher"], "target": ["sure", "safe"], "note": "„sure“ = überzeugt, „safe“ = ungefährlich." }
          ],
          "sentences": [
            { "native": ["Ich denke, das ist wahr."], "target": ["I think that is true.", "I think it is true.", "I think that's true.", "I think it's true.", "I think this is true."], "note": "„I think“ + Satz – „that“ ist optional." },
            { "native": ["Ich stimme dir zu."], "target": ["I agree with you.", "I agree."], "note": "„agree with someone“ – kein „am“: nicht „I am agree“." },
            { "native": ["Meiner Meinung nach ist das falsch."], "target": ["In my opinion that is wrong.", "In my opinion, that is wrong.", "In my opinion, it is wrong.", "In my opinion that's wrong."], "note": "„meiner Meinung nach“ = „in my opinion“." },
            { "native": ["Vielleicht hast du recht."], "target": ["Maybe you are right.", "Perhaps you are right.", "Maybe you're right.", "Perhaps you're right."], "note": "„recht haben“ = „to be right“." },
            { "native": ["Das ist wichtig, weil es hilft."], "target": ["That is important because it helps.", "This is important because it helps.", "It is important because it helps."], "note": "Nach „because“ bleibt die normale Wortstellung." },
            { "native": ["Ich bin nicht sicher."], "target": ["I am not sure.", "I'm not sure."], "note": "Unsicherheit: „not sure“." },
            { "native": ["Das ist eine bessere Idee."], "target": ["That is a better idea.", "That's a better idea.", "This is a better idea."], "note": "good → better (Komparativ)." },
            { "native": ["Ich glaube dir."], "target": ["I believe you."], "note": "„believe someone“ – ohne Präposition." },
            { "native": ["Es ist gut, aber teuer."], "target": ["It is good but expensive.", "It is good, but expensive.", "It's good but expensive.", "It's good, but expensive."], "note": "„aber“ = „but“." }
          ]
        },
        {
          "id": "b1-future",
          "title": "Pläne & Zukunft",
          "description": "will, going to, Pläne machen",
          "words": [
            { "native": ["Plan"], "target": ["plan"] },
            { "native": ["Zukunft"], "target": ["future"] },
            { "native": ["bald"], "target": ["soon"] },
            { "native": ["nächste"], "target": ["next"] },
            { "native": ["hoffen"], "target": ["hope"] },
            { "native": ["vergessen"], "target": ["forget"] },
            { "native": ["anrufen"], "target": ["call", "phone"] },
            { "native": ["später"], "target": ["later"] },
            { "native": ["Wochenende"], "target": ["weekend"] },
            { "native": ["umziehen"], "target": ["move"] },
            { "native": ["vielleicht nicht"], "target": ["maybe not", "perhaps not"] },
            { "native": ["Jahr"], "target": ["year"] }
          ],
          "sentences": [
            { "native": ["Ich rufe dich später an."], "target": ["I will call you later.", "I'll call you later.", "I will phone you later."], "note": "Spontane Zusage: „will“ + Grundform." },
            { "native": ["Wir ziehen nächstes Jahr um."], "target": ["We are moving next year.", "We are going to move next year.", "We will move next year."], "note": "Feste Pläne: „be going to“ oder Verlaufsform." },
            { "native": ["Was machst du am Wochenende?"], "target": ["What are you doing at the weekend?", "What are you doing on the weekend?", "What are you doing this weekend?"], "note": "Pläne erfragen mit Verlaufsform: „What are you doing …?“" },
            { "native": ["Ich hoffe, es regnet nicht."], "target": ["I hope it does not rain.", "I hope it doesn't rain.", "I hope it will not rain.", "I hope it won't rain."], "note": "Nach „hope“ oft Gegenwart mit Zukunftsbedeutung." },
            { "native": ["Vergiss es nicht!"], "target": ["Do not forget it!", "Don't forget it!", "Don't forget!"], "note": "Verneinte Aufforderung: „Don't …!“" },
            { "native": ["Ich werde bald Englisch sprechen."], "target": ["I will speak English soon.", "I will soon speak English.", "I'll speak English soon."], "note": "Zukunft mit „will“: will + Grundform." },
            { "native": ["Hast du einen Plan?"], "target": ["Do you have a plan?", "Have you got a plan?"], "note": "„Do you have …?“ ist überall üblich." },
            { "native": ["Die Zukunft ist offen."], "target": ["The future is open."], "note": "„future“ mit „the“, wenn allgemein gemeint." },
            { "native": ["Nächste Woche fliege ich nach Rom."], "target": ["Next week I am flying to Rome.", "I am flying to Rome next week.", "Next week I will fly to Rome.", "I'm flying to Rome next week."], "note": "„nächste Woche“ = „next week“, ohne „the“." }
          ]
        }
      ]
    }
