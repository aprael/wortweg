          ],
          "sentences": [
            { "native": ["Ich bin krank."], "target": ["I am ill.", "I am sick.", "I'm ill.", "I'm sick."], "note": "„ill“ (eher britisch) und „sick“ (eher amerikanisch)." },
            { "native": ["Ich habe Kopfschmerzen."], "target": ["I have a headache.", "I've got a headache.", "I have got a headache."], "note": "Kopf + Schmerz = „headache“, mit „a“." },
            { "native": ["Ich brauche einen Arzt."], "target": ["I need a doctor."], "note": "„brauchen“ = „need“." },
            { "native": ["Können Sie mir helfen?"], "target": ["Can you help me?", "Could you help me?"], "note": "„Could you …?“ ist besonders höflich." },
            { "native": ["Er hat Fieber."], "target": ["He has a fever.", "He has a temperature.", "He's got a fever.", "He has got a fever."], "note": "Britisch oft: „to have a temperature“." },
            { "native": ["Mein Bauch tut weh."], "target": ["My stomach hurts.", "My belly hurts."], "note": "„weh tun“ = „hurt“; bei „it“ mit -s: „hurts“." },
            { "native": ["Ich habe einen Termin."], "target": ["I have an appointment.", "I've got an appointment."], "note": "Termin beim Arzt = „appointment“ (Vokal → „an“)." },
            { "native": ["Nimm eine Tablette."], "target": ["Take a pill.", "Take a tablet."], "note": "Medikamente „nehmen“ = „take“." },
            { "native": ["Sie ist wieder gesund."], "target": ["She is healthy again.", "She is well again.", "She's well again."], "note": "„wieder gesund“ wird oft „well again“ ausgedrückt." }
          ]
        }
      ]
