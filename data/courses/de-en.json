      "title": "A1 · Einstieg",
      "units": [
        {
          "id": "a1-greetings",
          "title": "Begrüßung",
          "description": "Hallo sagen, sich vorstellen, höflich sein",
          "words": [
            { "native": ["Hallo"], "target": ["hello", "hi"] },
            { "native": ["Tschüss"], "target": ["bye", "goodbye"] },
            { "native": ["danke"], "target": ["thank you", "thanks"] },
            { "native": ["bitte"], "target": ["please"], "note": "„please“ benutzt man beim Bitten. Als Antwort auf „thank you“ sagt man „you're welcome“." },
            { "native": ["ja"], "target": ["yes"] },
            { "native": ["nein"], "target": ["no"] },
            { "native": ["Name"], "target": ["name"] },
            { "native": ["Freund"], "target": ["friend"] },
            { "native": ["gut"], "target": ["good", "well"], "note": "„good“ ist ein Adjektiv, „well“ beschreibt oft, wie es jemandem geht: „I'm well“." },
            { "native": ["Morgen"], "target": ["morning"], "note": "„Morgen“ als Tageszeit ist „morning“, „morgen“ (der nächste Tag) ist „tomorrow“." },
            { "native": ["Entschuldigung"], "target": ["sorry", "excuse me"], "note": "„excuse me“ vor einer Bitte, „sorry“ nach einem Fehler." },
            { "native": ["Abend"], "target": ["evening"] }
          ],
          "sentences": [
            { "native": ["Hallo, ich bin Anna."], "target": ["Hello, I am Anna.", "Hi, I am Anna."], "note": "„ich bin“ = „I am“. „I“ wird im Englischen immer großgeschrieben." },
            { "native": ["Wie heißt du?"], "target": ["What is your name?", "What's your name?"], "note": "Wörtlich: „Was ist dein Name?“ – im Englischen fragt man nach dem Namen mit „what“." },
            { "native": ["Mein Name ist Tom."], "target": ["My name is Tom."], "note": "„mein“ = „my“, „ist“ = „is“." },
            { "native": ["Guten Morgen!"], "target": ["Good morning!"], "note": "Feste Grußformel: „good“ + Tageszeit." },
            { "native": ["Danke, gut."], "target": ["Thank you, good.", "Thanks, good.", "Thank you, well.", "Thanks, well."], "note": "Kurze Antwort auf „How are you?“. Natürlicher: „Fine, thanks.“" },
            { "native": ["Wie geht es dir?"], "target": ["How are you?"], "note": "Feste Wendung: wörtlich „Wie bist du?“" },
            { "native": ["Das ist mein Freund."], "target": ["This is my friend.", "That is my friend."], "note": "Beim Vorstellen von Personen sagt man „this is …“." },
            { "native": ["Guten Abend, Herr Smith."], "target": ["Good evening, Mr Smith.", "Good evening, Mr. Smith."], "note": "„Herr“ = „Mr“ (britisch ohne Punkt, amerikanisch „Mr.“)." },
            { "native": ["Ja, bitte."], "target": ["Yes, please."], "note": "Höfliche Zustimmung zu einem Angebot." }
          ]
        },
        {
          "id": "a1-people",
          "title": "Menschen & Familie",
          "description": "Familie, Personen und „sein“",
          "words": [
            { "native": ["Mutter"], "target": ["mother", "mum", "mom"] },
            { "native": ["Vater"], "target": ["father", "dad"] },
            { "native": ["Bruder"], "target": ["brother"] },
            { "native": ["Schwester"], "target": ["sister"] },
            { "native": ["Kind"], "target": ["child", "kid"], "note": "Mehrzahl unregelmäßig: „children“." },
            { "native": ["Frau"], "target": ["woman", "wife"], "note": "„woman“ = Frau allgemein, „wife“ = Ehefrau." },
            { "native": ["Mann"], "target": ["man", "husband"], "note": "„man“ = Mann allgemein, „husband“ = Ehemann." },
            { "native": ["Familie"], "target": ["family"] },
            { "native": ["groß"], "target": ["tall", "big"], "note": "Bei Menschen: „tall“, bei Dingen: „big“." },
            { "native": ["jung"], "target": ["young"] },
            { "native": ["alt"], "target": ["old"] },
            { "native": ["nett"], "target": ["nice", "kind"] }
          ],
          "sentences": [
            { "native": ["Meine Mutter ist nett."], "target": ["My mother is nice.", "My mum is nice.", "My mom is nice.", "My mother is kind."], "note": "„my“ ist für alle Geschlechter gleich: kein „meine/mein“-Unterschied." },
            { "native": ["Er ist mein Bruder."], "target": ["He is my brother."], "note": "„er“ = „he“, „sie“ (Einzahl) = „she“." },
            { "native": ["Wir sind eine Familie."], "target": ["We are a family."], "note": "„wir sind“ = „we are“." },
            { "native": ["Sie ist jung."], "target": ["She is young."], "note": "„she is“ – bei Einzahl „sie“." },
            { "native": ["Mein Vater ist groß."], "target": ["My father is tall.", "My dad is tall."], "note": "Körpergröße von Menschen: „tall“." },
            { "native": ["Das Kind ist drei."], "target": ["The child is three.", "The kid is three."], "note": "Beim Alter reicht die Zahl: „She is ten.“ – ohne „years“." },
            { "native": ["Hast du eine Schwester?"], "target": ["Do you have a sister?", "Have you got a sister?"], "note": "Fragen mit „have“ bildet man mit „do“: „Do you have …?“" },
            { "native": ["Der Mann ist alt."], "target": ["The man is old."], "note": "„der/die/das“ = immer „the“." },
            { "native": ["Sie sind Kinder."], "target": ["They are children.", "They are kids."], "note": "„sie“ (Mehrzahl) = „they“; „child“ → „children“." }
          ]
        },
        {
          "id": "a1-food",
          "title": "Essen & Trinken",
          "description": "Bestellen, mögen, Hunger haben",
          "words": [
            { "native": ["Wasser"], "target": ["water"] },
            { "native": ["Brot"], "target": ["bread"] },
            { "native": ["Apfel"], "target": ["apple"], "note": "Vor Vokal-Laut: „an apple“ statt „a apple“." },
            { "native": ["Kaffee"], "target": ["coffee"] },
            { "native": ["Tee"], "target": ["tea"] },
            { "native": ["Milch"], "target": ["milk"] },
            { "native": ["Käse"], "target": ["cheese"] },
            { "native": ["Ei"], "target": ["egg"] },
            { "native": ["essen"], "target": ["eat"] },
            { "native": ["trinken"], "target": ["drink"] },
            { "native": ["mögen"], "target": ["like"] },
            { "native": ["Hunger"], "target": ["hunger"], "note": "„Ich habe Hunger“ sagt man mit Adjektiv: „I am hungry“." }
          ],
          "sentences": [
            { "native": ["Ich trinke Wasser."], "target": ["I drink water.", "I am drinking water."], "note": "Gewohnheit: einfache Gegenwart „I drink“. Gerade jetzt: „I am drinking“." },
            { "native": ["Sie isst einen Apfel."], "target": ["She eats an apple.", "She is eating an apple."], "note": "Bei „he/she/it“ bekommt das Verb ein -s: „she eats“." },
            { "native": ["Ich mag Kaffee."], "target": ["I like coffee."], "note": "„mögen“ = „like“." },
            { "native": ["Ich habe Hunger."], "target": ["I am hungry.", "I'm hungry."], "note": "Englisch nutzt „sein + Adjektiv“: „I am hungry“, nicht „I have hunger“." },
            { "native": ["Wir essen Brot und Käse."], "target": ["We eat bread and cheese.", "We are eating bread and cheese."], "note": "„und“ = „and“." },
            { "native": ["Magst du Tee?"], "target": ["Do you like tea?"], "note": "Fragen in der Gegenwart: „Do you …?“" },
            { "native": ["Ein Kaffee mit Milch, bitte."], "target": ["A coffee with milk, please.", "One coffee with milk, please."], "note": "„please“ steht beim Bestellen oft am Satzende." },
            { "native": ["Er trinkt keinen Tee."], "target": ["He does not drink tea.", "He doesn't drink tea."], "note": "Verneinung: „does not“ + Grundform, ohne -s." },
            { "native": ["Das Ei ist gut."], "target": ["The egg is good."], "note": "„gut“ als Eigenschaft eines Dings: „good“." }
          ]
        },
        {
          "id": "a1-time",
          "title": "Zahlen & Zeit",
          "description": "Zahlen, Uhrzeit und Wochentage",
          "words": [
            { "native": ["eins"], "target": ["one"] },
            { "native": ["zwei"], "target": ["two"] },
            { "native": ["drei"], "target": ["three"] },
            { "native": ["zehn"], "target": ["ten"] },
            { "native": ["Tag"], "target": ["day"] },
            { "native": ["Woche"], "target": ["week"] },
            { "native": ["heute"], "target": ["today"] },
            { "native": ["morgen"], "target": ["tomorrow"] },
            { "native": ["Uhr"], "target": ["clock", "watch", "o'clock"], "note": "Uhrzeit: „five o'clock“. Gegenstand: „clock“ (Wand) oder „watch“ (Armband)." },
            { "native": ["Montag"], "target": ["Monday"], "note": "Wochentage werden im Englischen großgeschrieben." },
            { "native": ["Stunde"], "target": ["hour"], "note": "Das „h“ ist stumm: „an hour“." },
            { "native": ["spät"], "target": ["late"] }
          ],
          "sentences": [
            { "native": ["Es ist drei Uhr."], "target": ["It is three o'clock.", "It's three o'clock.", "It is three."], "note": "Volle Stunden: Zahl + „o'clock“." },
            { "native": ["Heute ist Montag."], "target": ["Today is Monday.", "It is Monday today."], "note": "Wochentage immer großschreiben: „Monday“." },
            { "native": ["Ich habe zwei Brüder."], "target": ["I have two brothers.", "I have got two brothers.", "I've got two brothers."], "note": "Regelmäßige Mehrzahl mit -s: „brother“ → „brothers“." },
            { "native": ["Bis morgen!"], "target": ["See you tomorrow!", "Until tomorrow!"], "note": "Natürliche Verabschiedung: „See you tomorrow!“" },
            { "native": ["Eine Woche hat sieben Tage."], "target": ["A week has seven days."], "note": "„hat“ bei „he/she/it“ = „has“." },
            { "native": ["Es ist spät."], "target": ["It is late.", "It's late."], "note": "Bei Zeit und Wetter steht „it“ als Subjekt." },
            { "native": ["Wie spät ist es?"], "target": ["What time is it?"], "note": "Feste Frage nach der Uhrzeit: „What time is it?“" },
            { "native": ["Ich arbeite zehn Stunden."], "target": ["I work ten hours.", "I work for ten hours."], "note": "„hour“ → „hours“, das „h“ bleibt stumm." },
            { "native": ["Der Tag ist lang."], "target": ["The day is long."], "note": "„lang“ = „long“." }
          ]
        },
        {
          "id": "a1-home",
          "title": "Zuhause & Alltag",
          "description": "Wohnung, Gegenstände, „es gibt“",
          "words": [
            { "native": ["Haus"], "target": ["house", "home"], "note": "„house“ = Gebäude, „home“ = Zuhause." },
            { "native": ["Zimmer"], "target": ["room"] },
            { "native": ["Küche"], "target": ["kitchen"] },
            { "native": ["Tisch"], "target": ["table"] },
            { "native": ["Stuhl"], "target": ["chair"] },
            { "native": ["Bett"], "target": ["bed"] },
            { "native": ["Tür"], "target": ["door"] },
            { "native": ["Fenster"], "target": ["window"] },
            { "native": ["schlafen"], "target": ["sleep"] },
            { "native": ["wohnen"], "target": ["live"] },
            { "native": ["klein"], "target": ["small", "little"] },
            { "native": ["neu"], "target": ["new"] }
          ],
          "sentences": [
            { "native": ["Ich wohne in Berlin."], "target": ["I live in Berlin."], "note": "„wohnen“ = „live“." },
            { "native": ["Das Haus ist klein."], "target": ["The house is small.", "The house is little."], "note": "„small“ ist neutral, „little“ klingt oft gefühlvoll." },
            { "native": ["Es gibt einen Tisch in der Küche."], "target": ["There is a table in the kitchen.", "There's a table in the kitchen."], "note": "„es gibt“ = „there is“ (Einzahl) bzw. „there are“ (Mehrzahl)." },
            { "native": ["Die Tür ist neu."], "target": ["The door is new."], "note": "Adjektive ändern sich im Englischen nicht." },
            { "native": ["Er schläft im Bett."], "target": ["He sleeps in bed.", "He is sleeping in bed.", "He sleeps in the bed.", "He is sleeping in the bed."], "note": "„in bed“ ohne Artikel bedeutet „im Bett (zum Schlafen)“." },
            { "native": ["Mein Zimmer hat zwei Fenster."], "target": ["My room has two windows."], "note": "„my room has“ – dritte Person Einzahl → „has“." },
            { "native": ["Wo ist der Stuhl?"], "target": ["Where is the chair?", "Where's the chair?"], "note": "„wo“ = „where“, nicht „who“ (= wer)." },
            { "native": ["Wir sind zu Hause."], "target": ["We are at home.", "We are home."], "note": "„zu Hause“ = „at home“." },
            { "native": ["Es gibt drei Zimmer."], "target": ["There are three rooms."], "note": "Mehrzahl: „there are“." }
          ]
        }
      ]
    },
    {
      "id": "a2",
      "title": "A2 · Aufbau",
      "units": [
        {
          "id": "a2-travel",
          "title": "Reisen",
          "description": "Unterwegs sein, nach dem Weg fragen",
          "words": [
            { "native": ["Zug"], "target": ["train"] },
            { "native": ["Bahnhof"], "target": ["station", "train station"] },
            { "native": ["Fahrkarte"], "target": ["ticket"] },
            { "native": ["Flughafen"], "target": ["airport"] },
            { "native": ["Straße"], "target": ["street", "road"] },
            { "native": ["links"], "target": ["left"] },
            { "native": ["rechts"], "target": ["right"] },
            { "native": ["Hotel"], "target": ["hotel"] },
            { "native": ["Koffer"], "target": ["suitcase"] },
            { "native": ["Karte"], "target": ["map", "card", "ticket"], "note": "Landkarte = „map“, Spielkarte/Bankkarte = „card“." },
            { "native": ["reisen"], "target": ["travel"] },
            { "native": ["weit"], "target": ["far"] }
          ],
          "sentences": [
            { "native": ["Wo ist der Bahnhof?"], "target": ["Where is the station?", "Where is the train station?", "Where's the station?"], "note": "Nach dem Weg fragen: „Where is …?“" },
            { "native": ["Eine Fahrkarte nach London, bitte."], "target": ["A ticket to London, please.", "One ticket to London, please."], "note": "Richtung mit „to“: „a ticket to London“." },
            { "native": ["Gehen Sie nach links."], "target": ["Go left.", "Turn left."], "note": "Aufforderungen: Grundform des Verbs ohne Subjekt." },
            { "native": ["Der Zug ist spät."], "target": ["The train is late."], "note": "„Verspätung haben“ = „to be late“." },
            { "native": ["Ist es weit?"], "target": ["Is it far?"], "note": "Fragen mit „be“: Verb nach vorn – „Is it …?“" },
            { "native": ["Ich reise gern."], "target": ["I like travelling.", "I like traveling.", "I like to travel."], "note": "„gern tun“ = „like + -ing“ oder „like to …“." },
            { "native": ["Mein Koffer ist im Hotel."], "target": ["My suitcase is in the hotel.", "My suitcase is at the hotel."], "note": "„im“ = „in the“." },
            { "native": ["Das Hotel ist rechts."], "target": ["The hotel is on the right.", "The hotel is to the right."], "note": "Position: „on the right / on the left“." },
            { "native": ["Wir fahren zum Flughafen."], "target": ["We are going to the airport.", "We go to the airport.", "We are driving to the airport."], "note": "„fahren“ ist oft einfach „go“; „drive“ nur, wenn man selbst fährt." }
          ]
        },
        {
          "id": "a2-shopping",
          "title": "Einkaufen",
          "description": "Preise, Größen, bezahlen",
          "words": [
            { "native": ["Geschäft"], "target": ["shop", "store"] },
            { "native": ["Preis"], "target": ["price"] },
            { "native": ["teuer"], "target": ["expensive"] },
            { "native": ["billig"], "target": ["cheap"] },
            { "native": ["kaufen"], "target": ["buy"] },
            { "native": ["bezahlen"], "target": ["pay"] },
            { "native": ["Geld"], "target": ["money"], "note": "„money“ ist nicht zählbar: kein „moneys“." },
            { "native": ["Hemd"], "target": ["shirt"] },
            { "native": ["Schuhe"], "target": ["shoes"] },
            { "native": ["Größe"], "target": ["size"] },
            { "native": ["offen"], "target": ["open"] },
            { "native": ["geschlossen"], "target": ["closed"] }
          ],
          "sentences": [
            { "native": ["Wie viel kostet das?"], "target": ["How much is this?", "How much does this cost?", "How much is that?", "How much does that cost?"], "note": "Preisfrage: „How much …?“" },
            { "native": ["Das ist zu teuer."], "target": ["That is too expensive.", "This is too expensive.", "That's too expensive."], "note": "„zu“ vor einem Adjektiv = „too“." },
            { "native": ["Ich möchte dieses Hemd kaufen."], "target": ["I would like to buy this shirt.", "I'd like to buy this shirt.", "I want to buy this shirt."], "note": "Höflich: „I would like to …“" },
            { "native": ["Kann ich mit Karte bezahlen?"], "target": ["Can I pay by card?", "Can I pay with card?", "Can I pay with a card?"], "note": "„mit Karte“ = „by card“." },
            { "native": ["Das Geschäft ist geschlossen."], "target": ["The shop is closed.", "The store is closed."], "note": "„shop“ (britisch), „store“ (amerikanisch)." },
            { "native": ["Haben Sie das in Größe 40?"], "target": ["Do you have this in size 40?", "Do you have that in size 40?", "Have you got this in size 40?"], "note": "„in size …“ – ohne Artikel." },
            { "native": ["Die Schuhe sind billig."], "target": ["The shoes are cheap."], "note": "Mehrzahl → „are“." },
            { "native": ["Ich habe kein Geld."], "target": ["I have no money.", "I do not have any money.", "I don't have any money."], "note": "„kein“ = „no“ oder „not … any“." },
            { "native": ["Ist der Laden heute offen?"], "target": ["Is the shop open today?", "Is the store open today?"], "note": "„open“ ist hier ein Adjektiv: „is open“." }
          ]
        },
